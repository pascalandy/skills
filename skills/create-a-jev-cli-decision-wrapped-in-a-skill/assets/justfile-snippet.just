# Jev decision gates (generated by create-a-jev-cli-decision-wrapped-in-a-skill). Any recipe accepts --help.

# Run any jevgate command; `just jev` alone prints the help.
[group('jev')]
[positional-arguments]
jev *args:
    uv run --script .jev/jevgate.py "$@"

# Judge whether this branch is ready to merge; runs the check command first. See `just jev-merge --help`.
[group('jev')]
[positional-arguments]
jev-merge *args:
    uv run --script .jev/jevgate.py run merge --run-ci "$@"
